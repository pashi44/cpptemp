{
    "version": "0.2.0",
    "configurations": [
        {

            
            "name": "Debug TempOne",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build TempOne",
            "program": "${workspaceFolder}/build/TempOne",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole":   false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
