{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug My Program",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/TempOne",  // Path to your executable
      "args": [],                                     // Command-line arguments
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",                    // Working directory
      "environment": [],
      "externalConsole": false,                        // Set true if you want external terminal
      "MIMode": "gdb",                                // Debugger mode
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build",                        // Optional: build task to run before debug
      "miDebuggerPath": "/usr/bin/gdb",                // Path to gdb
      "logging": { "engineLogging": false }
    }
  ]
}
